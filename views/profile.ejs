<%- include('partials/header', { title: 'My levels' }) %>
<h1><%= t('My levels') %></h1>
<% if (levels.length === 0) { %>
<div class="empty">
  <p><%= t('You have not published any levels yet.') %></p>
  <a class="button" href="/levels/new"><%= t('New level') %></a>
</div>
<% } else { %>
<div class="grid">
  <% levels.forEach(function (level) { %><%- include('partials/level-card', { level: level }) %><% }) %>
</div>
<% } %>
<%- include('partials/footer') %>
