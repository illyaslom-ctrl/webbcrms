<%- include('../partials/header', { title: 'Levels' }) %>
<h1><%= t('Levels') %></h1>
<div class="toolbar">
  <form class="search-form" method="get" action="/levels" role="search">
    <label class="visually-hidden" for="q"><%= t('Search by level name') %></label>
    <input type="search" id="q" name="q" value="<%= q %>" placeholder="<%= t('Search by level name') %>">
    <button class="button" type="submit"><%= t('Search') %></button>
  </form>
  <a class="button" href="/levels/new"><%= t('New level') %></a>
</div>
<% if (total === 0) { %>
<div class="empty">
  <% if (q) { %>
  <p><%= t('Nothing found for {q}.', { q: q }) %></p>
  <% } else { %>
  <p><%= t('No levels yet. Be the first to publish one.') %></p>
  <a class="button" href="/levels/new"><%= t('New level') %></a>
  <% } %>
</div>
<% } else { %>
<div class="grid">
  <% levels.forEach(function (level) { %><%- include('../partials/level-card', { level: level }) %><% }) %>
</div>
<% const qs = q ? '&q=' + encodeURIComponent(q) : ''; %>
<nav class="pagination" aria-label="<%= t('Pages') %>">
  <% if (page > 1) { %>
  <a class="button button-secondary" href="/levels?page=<%= page - 1 %><%= qs %>"><%= t('Previous') %></a>
  <% } else { %>
  <span class="button button-secondary is-disabled" aria-disabled="true"><%= t('Previous') %></span>
  <% } %>
  <span class="page-text"><%= t('Page {page} of {pages}', { page: page, pages: pages }) %></span>
  <% if (page < pages) { %>
  <a class="button button-secondary" href="/levels?page=<%= page + 1 %><%= qs %>"><%= t('Next') %></a>
  <% } else { %>
  <span class="button button-secondary is-disabled" aria-disabled="true"><%= t('Next') %></span>
  <% } %>
</nav>
<% } %>
<%- include('../partials/footer') %>
