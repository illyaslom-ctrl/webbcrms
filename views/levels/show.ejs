<%- include('../partials/header', { title: level.name }) %>
<p><a class="back-link" href="/levels">Back to levels</a></p>

<div class="level-head">
  <div>
    <h1><%= level.name %></h1>
    <p class="level-meta">
      <% if (level.level_number !== null) { %><span>Level <%= level.level_number %></span><% } %>
      <span>by <%= level.username %>, <%= formatDate(level.created_at) %></span>
      <% if (level.danger_rating !== null) { %><span class="badge">Danger: <%= level.danger_rating %> / 5</span><% } %>
    </p>
  </div>
  <% if (isAuthor) { %>
  <div class="author-actions">
    <a class="button button-secondary" href="/levels/<%= level.id %>/edit">Edit</a>
    <form class="inline-form js-confirm" method="post" action="/levels/<%= level.id %>/delete" data-confirm="Delete this level? This cannot be undone.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="button button-secondary button-danger" type="submit">Delete</button>
    </form>
  </div>
  <% } %>
</div>

<section class="gallery" aria-label="Photos">
  <% if (photos.length) { %>
  <img id="gallery-main" class="gallery-main" src="/uploads/<%= photos[0].filename %>" alt="<%= level.name %> photo 1">
  <% if (photos.length > 1) { %>
  <div class="thumbs">
    <% photos.forEach(function (p, i) { %>
    <button class="thumb" type="button" data-src="/uploads/<%= p.filename %>" data-alt="<%= level.name %> photo <%= i + 1 %>">
      <img src="/uploads/<%= p.filename %>" alt="<%= level.name %> photo <%= i + 1 %>" loading="lazy">
    </button>
    <% }) %>
  </div>
  <% } %>
  <% } else { %>
  <div class="gallery-main no-photo">No photo</div>
  <% } %>
</section>

<% if (level.music_name || level.music_file) { %>
<section class="level-section">
  <h2>Music</h2>
  <% if (level.music_name) { %><p><%= level.music_name %></p><% } %>
  <% if (level.music_file) { %><audio controls src="/uploads/<%= level.music_file %>"></audio><% } %>
</section>
<% } %>

<%
  const sections = [
    ['Description', level.description],
    ['Entities', level.entities],
    ['Entries', level.entries],
    ['Exits', level.exits],
    ['Features', level.features],
    ['Lovely places', level.lovely_places],
    ['Danger areas', level.danger_areas]
  ];
%>
<% sections.forEach(function (s) { if (s[1]) { %>
<section class="level-section">
  <h2><%= s[0] %></h2>
  <p class="prose"><%= s[1] %></p>
</section>
<% } }) %>

<section class="level-section comments" id="comments" aria-labelledby="comments-heading">
  <h2 id="comments-heading">Comments (<%= comments.length %>)</h2>

  <% if (comments.length === 0) { %>
  <p class="helper">No comments yet.</p>
  <% } %>

  <ul class="comment-list">
    <% comments.forEach(function (c) { %>
    <li class="comment" id="comment-<%= c.id %>">
      <%- include('../partials/avatar', { person: c, size: 'md' }) %>
      <div class="comment-main">
        <p class="comment-head">
          <strong><%= c.username %></strong>
          <span class="comment-date"><%= formatDate(c.created_at) %></span>
        </p>
        <p class="prose"><%= c.body %></p>
        <% if (user && user.id === c.user_id) { %>
        <form class="inline-form js-confirm" method="post" action="/levels/<%= level.id %>/comments/<%= c.id %>/delete" data-confirm="Delete this comment?">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="link-button" type="submit">Delete</button>
        </form>
        <% } %>
      </div>
    </li>
    <% }) %>
  </ul>

  <% if (user) { %>
  <form class="comment-form" method="post" action="/levels/<%= level.id %>/comments" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="comment-body">Add a comment</label>
    <textarea id="comment-body" name="body" rows="4" data-max="<%= commentMax %>" aria-describedby="comment-body-count"></textarea>
    <p class="counter" id="comment-body-count" data-counter-for="comment-body">0 / <%= commentMax %></p>
    <button class="button" type="submit">Post comment</button>
  </form>
  <% } else { %>
  <p><a href="/login">Log in</a> or <a href="/register">create an account</a> to write a comment.</p>
  <% } %>
</section>
<%- include('../partials/footer') %>
